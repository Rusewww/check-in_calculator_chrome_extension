{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "chrome"]
  },
  "include": ["src", "tests", "scripts", "vite.config.js"],
  "exclude": ["node_modules", "dist", "scripts/package-zip.mjs", "scripts/build-fonts.mjs"]
}
